{
  "name": "devtoolkit-editor",
  "private": true,
  "description": "Builds static/vendor/editor.js (CodeMirror 6 YAML editor) with esbuild",
  "scripts": {
    "build": "esbuild src/editor.js --bundle --minify --format=iife --target=es2020 --outfile=../static/vendor/editor.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
